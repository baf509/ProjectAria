#!/usr/bin/env python3
"""Read-only stdio discovery and readiness check; run with the pinned MCP Python."""
import asyncio
import json
import os
from pathlib import Path
import sys

from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client

REQUIRED = {"aria_health", "tool_contract_status", "fleet_status", "list_nodes",
            "create_coding_session", "resume_coding_session", "ralph_policy", "benchmark_catalog",
            "wait_for_shell_output", "host_temperatures", "get_memory", "store_memory",
            "awareness_observations", "get_research_report", "red_model_status", "select_red_model"}


def unpack(result):
    if result.isError:
        raise ValueError("MCP tool returned an error")
    if result.structuredContent is not None:
        return result.structuredContent
    return json.loads(next(c.text for c in result.content if c.type == "text"))


async def check(server):
    params = StdioServerParameters(command=sys.executable, args=[str(server)],
                                  env={k: os.environ[k] for k in ("ARIA_API_URL", "ARIA_API_KEY")
                                       if k in os.environ})
    with open(os.devnull, "w") as errors:
        async with stdio_client(params, errlog=errors) as (read, write):
            async with ClientSession(read, write) as session:
                await session.initialize()
                names = set()
                cursor = None
                while True:
                    result = await session.list_tools(cursor=cursor)
                    names.update(t.name for t in result.tools)
                    cursor = result.nextCursor
                    if not cursor:
                        break
                contract = unpack(await session.call_tool("tool_contract_status", {}))
                health = unpack(await session.call_tool("aria_health", {}))
                return {"ok": REQUIRED <= names and health.get("ready") is True,
                        "registered_count": len(names), "missing_required": sorted(REQUIRED - names),
                        "contract": contract, "api_ready": health.get("ready") is True}


if __name__ == "__main__":
    try:
        result = asyncio.run(asyncio.wait_for(check(Path(sys.argv[1])), timeout=25))
    except Exception as exc:
        result = {"ok": False, "error": type(exc).__name__}
    print(json.dumps(result))
    raise SystemExit(0 if result["ok"] else 1)
