#!/bin/zsh
set -euo pipefail

readonly key=/Users/ben/Services/secrets/corsair_forward_ed25519
readonly known_hosts=/Users/ben/Services/config/corsair-known-hosts

# Ports 8002 (TTS) and 8104 (Gemma) are intentionally absent: those services
# are retained Mac services. Forward the current CUDA/Halo candidate plus
# optional STT, Context-1 and retained DeepSeek engineering endpoints.
# Retired R9700 loadouts (8080/8120/8121/8122) have no forwarding path.
exec /usr/bin/ssh -N \
  -p 2222 \
  -i "$key" \
  -o IdentitiesOnly=yes \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile="$known_hosts" \
  -o HostKeyAlias=corsair-ai.local \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -L 127.0.0.1:8003:127.0.0.1:8003 \
  -L 127.0.0.1:8081:127.0.0.1:8081 \
  -L 127.0.0.1:8107:127.0.0.1:8107 \
  -L 127.0.0.1:8131:127.0.0.1:8131 \
  ben@100.123.245.84
