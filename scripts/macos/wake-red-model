#!/usr/bin/env python3
"""Ask the existing Corsair LAN relay to wake Red; Aria verifies readiness."""
import json
from pathlib import Path
import urllib.request


def main():
    token = Path('/Users/ben/Services/secrets/red-wake-relay.token').read_text().strip()
    if not token:
        raise RuntimeError('Wake relay credential is empty')
    request = urllib.request.Request(
        'http://corsair-ai:47997/wake/red', data=b'', method='POST',
        headers={'Authorization': 'Bearer ' + token},
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = json.load(response)
        if response.status != 202 or not body.get('ok'):
            raise RuntimeError('Corsair did not accept the Red wake request')
    print('Corsair accepted the Red wake packet; host readiness is still pending.')


if __name__ == '__main__':
    main()
