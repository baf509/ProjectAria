#!/usr/bin/env python3
"""End-to-end, idempotent ARIA/Hermes boot readiness canary."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import random
import subprocess
import sys
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


DEFAULT_URL = os.environ.get("ARIA_API_URL", "http://127.0.0.1:8200").rstrip("/")


def _scoped_key() -> str:
    if os.environ.get("ARIA_API_KEY"):
        return os.environ["ARIA_API_KEY"]
    env_file = Path("~/.config/aria/env").expanduser()
    try:
        for line in env_file.read_text(encoding="utf-8").splitlines():
            if line.startswith("ARIA_API_KEY="):
                return line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return ""


def _request(base: str, method: str, path: str, *, body: dict | None = None) -> tuple[int, dict]:
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Accept": "application/json"}
    key = _scoped_key()
    if key:
        headers["X-API-Key"] = key
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = Request(base + path, data=data, headers=headers, method=method)
    try:
        with urlopen(request, timeout=10) as response:
            raw = response.read()
            return response.status, json.loads(raw) if raw else {}
    except HTTPError as exc:
        raw = exc.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"detail": raw.decode(errors="replace")[:300]}
        return exc.code, payload


def _wait_ready(base: str, timeout: float) -> tuple[bool, dict, float]:
    started = time.monotonic()
    deadline = started + timeout
    last: dict = {"detail": "not attempted"}
    delay = 0.5
    while True:
        try:
            status, last = _request(base, "GET", "/api/v1/health/ready")
            if status == 200:
                return True, last, time.monotonic() - started
        except (URLError, TimeoutError, OSError) as exc:
            last = {"detail": str(exc)}
        if time.monotonic() >= deadline:
            return False, last, time.monotonic() - started
        time.sleep(min(delay + random.uniform(0, delay / 4), max(deadline - time.monotonic(), 0)))
        delay = min(delay * 1.7, 8.0)


def _launchd_running(label: str) -> bool:
    try:
        completed = subprocess.run(
            ["launchctl", "print", f"system/{label}"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return completed.returncode == 0 and "state = running" in completed.stdout


def _mcp_contract(path: Path, base: str = DEFAULT_URL) -> dict:
    reference = Path(__file__).resolve().parents[1] / "mcp"
    try:
        data = path.read_bytes()
        operations = path.with_name("operations.py").read_bytes()
        expected = hashlib.sha256((reference / "server.py").read_bytes()).hexdigest()
        expected_operations = hashlib.sha256((reference / "operations.py").read_bytes()).hexdigest()
    except OSError as exc:
        return {"ok": False, "error": str(exc)}
    actual = hashlib.sha256(data).hexdigest()
    actual_operations = hashlib.sha256(operations).hexdigest()
    if (actual, actual_operations) != (expected, expected_operations):
        return {"ok": False, "error": "Installed MCP differs from the release contract"}
    environment = {**os.environ, "ARIA_API_KEY": _scoped_key(), "ARIA_API_URL": base}
    try:
        result = subprocess.run(
            [str(path.parent / ".venv/bin/python"),
             str(Path(__file__).resolve().with_name("aria-mcp-check")), str(path)],
            env=environment, capture_output=True, text=True, timeout=30,
        )
        report = json.loads(result.stdout)
        contract = report.get("contract", {})
        report["ok"] = bool(report.get("ok") and result.returncode == 0
                            and contract.get("sha256") == expected
                            and contract.get("operations_sha256") == expected_operations)
        return report
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": type(exc).__name__}


def _node_health(status: int, nodes, required: list[str], max_age: float) -> dict:
    if status != 200 or not isinstance(nodes, list):
        return {"ok": False, "status": status, "error": "Node registry unavailable"}
    by_id = {node.get("node_id"): node for node in nodes if isinstance(node, dict)}
    checks = {}
    now = datetime.now(timezone.utc)
    for node_id in required:
        node = by_id.get(node_id, {})
        try:
            at = datetime.fromisoformat(node["last_heartbeat_at"].replace("Z", "+00:00"))
            age = (now - at).total_seconds()
        except (KeyError, TypeError, ValueError):
            age = None
        checks[node_id] = {"ok": node.get("status") == "online" and age is not None
                          and -30 <= age <= max_age,
                          "heartbeat_age_seconds": round(age, 1) if age is not None else None}
    return {"ok": all(check["ok"] for check in checks.values()), "required": checks}


def _harmless_shell_canary(base: str) -> dict:
    name = f"boot-canary-{os.getpid()}-{int(time.time())}"
    status, created = _request(
        base,
        "POST",
        "/api/v1/shells",
        body={"name": name, "profile": "shell", "launch_claude": False},
    )
    if status != 201:
        return {"ok": False, "create_status": status, "detail": created}
    canonical = created.get("name", name)
    delete_status, detail = _request(
        base, "DELETE", f"/api/v1/shells/{canonical}?purge=true"
    )
    return {
        "ok": delete_status in {200, 202, 204},
        "canonical_name": canonical,
        "delete_status": delete_status,
        "pending": delete_status == 202,
        "detail": detail,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--api-url", default=DEFAULT_URL)
    parser.add_argument("--wait", type=float, default=0)
    parser.add_argument("--canary-shell", action="store_true")
    parser.add_argument("--required-node", action="append",
                        help="Repeat to override the required always-on nodes; sleeping GPU nodes are excluded")
    parser.add_argument("--heartbeat-max-age", type=float, default=120)
    parser.add_argument(
        "--mcp-source",
        default="/Users/ben/Services/apps/aria-mcp/server.py",
    )
    args = parser.parse_args(argv)
    deadline = time.monotonic() + max(args.wait, 0)
    ready, readiness, wait_seconds = _wait_ready(args.api_url, args.wait)
    report = {
        "ok": ready,
        "checked_at": time.time(),
        "time_to_aria_ready_from_check_seconds": round(wait_seconds, 3),
        "aria_readiness": readiness,
    }
    if ready:
        while True:
            report["launchd"] = {
                "aria_api": _launchd_running("com.ben.devbox.aria-api"),
                "aria_ui": _launchd_running("com.ben.devbox.aria-ui"),
                "aria_node": _launchd_running("com.ben.devbox.aria-agent-node"),
                "hermes_gateway": _launchd_running("com.ben.devbox.hermes-gateway"),
                "signal_cli": _launchd_running("com.ben.devbox.signal-cli"),
            }
            report["mcp_contract"] = _mcp_contract(Path(args.mcp_source), args.api_url)
            try:
                status, nodes = _request(args.api_url, "GET", "/api/v1/nodes")
                report["nodes"] = _node_health(
                    status, nodes, args.required_node or ["bens-macbook-pro", "mac-agents", "corsair-ai"],
                    args.heartbeat_max_age,
                )
            except (OSError, ValueError) as exc:
                report["nodes"] = {"ok": False, "error": type(exc).__name__}
            report["ok"] = bool(all(report["launchd"].values())
                                and report["mcp_contract"]["ok"] and report["nodes"]["ok"])
            if report["ok"] or time.monotonic() >= deadline:
                break
            time.sleep(min(3, max(0, deadline - time.monotonic())))
        if args.canary_shell and report["ok"]:
            report["managed_shell_canary"] = _harmless_shell_canary(args.api_url)
            report["ok"] = report["ok"] and report["managed_shell_canary"]["ok"]
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
