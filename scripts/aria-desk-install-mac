#!/bin/zsh
# Install the maintained Mac ARIA coding-shell wrappers.

set -euo pipefail

readonly repo="$(cd "$(dirname "$0")/.." && pwd)"
readonly config="$HOME/.config/aria"
readonly zshrc="$HOME/.zshrc"
readonly source_line='[ -f "$HOME/.config/aria/aria-shells-mac.sh" ] && . "$HOME/.config/aria/aria-shells-mac.sh"'

for file in aria-shells-mac.sh aria-local-shell; do
    [ -r "$repo/scripts/$file" ] || {
        print -u2 "missing $repo/scripts/$file"
        exit 1
    }
done

[ -s "$config/env" ] || {
    print -u2 'Refusing to install without ~/.config/aria/env.'
    print -u2 'Provision a scoped ARIA_API_KEY there; this installer never copies service secrets.'
    exit 1
}

mkdir -p "$config"
install -m 0644 "$repo/scripts/aria-shells-mac.sh" "$config/aria-shells-mac.sh"
install -m 0755 "$repo/scripts/aria-local-shell" "$config/aria-local-shell"

if grep -q 'aria-shells-corsair-client.sh' "$zshrc" 2>/dev/null; then
    print -u2 'A legacy ARIA shell source line is still present in ~/.zshrc.'
    print -u2 "Replace it with: $source_line"
    exit 2
elif ! grep -q 'aria-shells-mac.sh' "$zshrc" 2>/dev/null; then
    # Accept either the canonical one-line form or an equivalent multiline
    # source statement. The wrapper path is the durable contract; whitespace
    # formatting in a human-owned shell rc file is not.
    printf '\n# ARIA persisted coding shells.\n%s\n' "$source_line" >> "$zshrc"
fi

python3 -m py_compile "$config/aria-local-shell"
zsh -n "$config/aria-shells-mac.sh"
print 'ARIA Mac shell wrappers installed. Open a new shell to activate them.'
