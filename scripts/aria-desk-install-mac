#!/usr/bin/env bash
#
# ARIA - emit a self-contained desk-path installer for a Mac
#
# Prints a shell script to stdout that installs the complexity-routing desk
# path (aria-claude.sh + aria-route-task + the API key) into ~/.config/aria and
# wires up ~/.zshrc. Everything is embedded, so the Mac needs no scp, no repo
# checkout, and no long command lines — which is the point: a long command
# pasted into a terminal can be split mid-line, and a split `scp a b` silently
# becomes a destructive remote-to-remote copy.
#
# Run it FROM the Mac:
#     ssh ben@corsair-ai 'bash Development/ProjectAria/scripts/aria-desk-install-mac' | sh
#
# Idempotent: re-running refreshes the scripts and the key, and appends to
# ~/.zshrc only if the wrapper isn't referenced there yet.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_URL="${ARIA_DESK_API_URL:-http://corsair-ai.tailb286a5.ts.net:8200}"

for f in aria-claude.sh aria-route-task; do
    [ -r "$REPO/scripts/$f" ] || { echo "missing $REPO/scripts/$f" >&2; exit 1; }
done

api_key="$(grep -E '^(ARIA_)?API_KEY=' "$REPO/.env" | head -1 | cut -d= -f2-)"
[ -n "$api_key" ] || { echo "no API key found in $REPO/.env" >&2; exit 1; }

# A delimiter no source line can collide with.
D="ARIA_INSTALL_EOF_9f3c1d"

cat <<INSTALLER_HEADER
# Generated by aria-desk-install-mac on $(hostname) — do not edit by hand.
set -e
mkdir -p ~/.config/aria
INSTALLER_HEADER

for f in aria-claude.sh aria-route-task; do
    printf "cat > ~/.config/aria/%s <<'%s'\n" "$f" "$D"
    cat "$REPO/scripts/$f"
    printf "%s\n" "$D"
done

cat <<INSTALLER_TAIL
chmod +x ~/.config/aria/aria-route-task
printf 'ARIA_API_KEY=%s\n' '${api_key}' > ~/.config/aria/env
chmod 600 ~/.config/aria/env

# Wire up ~/.zshrc once. The [ -f ] guard keeps a new shell working even if the
# wrapper is later removed. If ~/.zshrc already defines its own claude(), this
# would shadow it — bail out and say so rather than break it silently.
if grep -q 'aria-claude.sh' ~/.zshrc 2>/dev/null; then
    echo "~/.zshrc already sources the wrapper — left alone"
elif grep -q '^[[:space:]]*claude[[:space:]]*()' ~/.zshrc 2>/dev/null; then
    echo "REFUSING to edit ~/.zshrc: it already defines its own claude() function." >&2
    echo "Scripts are installed; add the two lines by hand, after that function." >&2
    exit 1
else
    printf '\n# ARIA complexity routing: claude "<task>" picks the model by complexity.\n' >> ~/.zshrc
    printf 'export ARIA_API_URL=%s\n' '${API_URL}' >> ~/.zshrc
    printf '[ -f ~/.config/aria/aria-claude.sh ] && . ~/.config/aria/aria-claude.sh\n' >> ~/.zshrc
    echo "~/.zshrc updated"
fi

echo
echo "installed. verifying against the API:"
ARIA_API_URL='${API_URL}' ~/.config/aria/aria-route-task --timeout 20 -- "design a caching layer"
INSTALLER_TAIL
