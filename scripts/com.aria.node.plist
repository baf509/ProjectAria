<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac control-node logical role. Install for the interactive Mac user:
    cp scripts/com.aria.node.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aria.node.plist

  The broad API key is read by scripts/aria-node from the operator-owned
  ~/.config/aria/env file. Never place it in this mode-0644 plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aria.node</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ben/Development/Infrastructure/ProjectAria/scripts/aria-node</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ARIA_API_URL</key>
        <string>http://127.0.0.1:8200</string>
        <key>ARIA_NODE_ID</key>
        <string>bens-macbook-pro</string>
        <key>ARIA_NODE_COMMAND_MODE</key>
        <string>control</string>
        <key>ARIA_API_DIR</key>
        <string>/Users/ben/Development/Infrastructure/ProjectAria/api</string>
        <key>ARIA_PYTHON</key>
        <string>/Users/ben/Services/venvs/aria-node/bin/python</string>
        <key>ARIA_ENV_FILE</key>
        <string>/Users/ben/.config/aria/env</string>
        <key>PATH</key>
        <string>/Users/ben/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/ben/Development/Infrastructure/ProjectAria/api</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ben/Library/Logs/aria-control-node.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ben/Library/Logs/aria-control-node.error.log</string>
</dict>
</plist>
