#!/usr/bin/env python3
"""Create or reattach a Mac-local coding shell through ARIA."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import random
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request


SHELL_PREFIX = "claude-"
DEFAULT_API_URL = "http://127.0.0.1:8200"
RETRYABLE_HTTP_CODES = {502, 503, 504}
DEFAULT_TMUX_HISTORY_LIMIT = 50_000


def _canonical_shell_name(name: str) -> str:
    """Apply the same idempotent tmux prefix rule as ShellService."""
    return name if name.startswith(SHELL_PREFIX) else f"{SHELL_PREFIX}{name}"


def _configure_tmux_session(name: str) -> None:
    """Make an ARIA shell stable and scrollable across terminal clients.

    tmux defaults to ``window-size latest``.  An ARIA shell is often attached
    from both a desktop terminal and a narrower SSH client, so focus changes
    otherwise send SIGWINCH and make Codex repaint its entire transcript.
    ``smallest`` keeps every attached client usable without focus-driven size
    changes.

    A newly attached terminal only owns the output it received after attach;
    older output lives in tmux's history.  Enabling mouse reporting gives
    Termius's wheel gesture to tmux, whose default WheelUpPane binding enters
    copy mode.  Keep enough history for long coding sessions rather than
    tmux's small 2,000-line default.  Every option is best-effort because a
    just-stopped shell may disappear between registration and attachment.
    """
    history_limit = os.environ.get(
        "ARIA_TMUX_HISTORY_LIMIT", str(DEFAULT_TMUX_HISTORY_LIMIT)
    )
    if not history_limit.isdigit() or int(history_limit) < 2_000:
        history_limit = str(DEFAULT_TMUX_HISTORY_LIMIT)
    commands = (
        ["tmux", "set-option", "-t", name, "mouse", "on"],
        [
            "tmux",
            "set-option",
            "-w",
            "-t",
            f"{name}:",
            "history-limit",
            history_limit,
        ],
        ["tmux", "set-option", "-w", "-t", f"{name}:", "window-size", "smallest"],
    )
    for command in commands:
        subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def _load_key() -> str:
    path = Path.home() / ".config" / "aria" / "env"
    if not path.is_file():
        return ""
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() in {"ARIA_API_KEY", "API_KEY"}:
            return value.strip()
    return ""


def _retry_delay(attempt: int) -> float:
    initial = max(float(os.environ.get("ARIA_STARTUP_RETRY_INITIAL_SECONDS", "0.5")), 0.01)
    ceiling = max(float(os.environ.get("ARIA_STARTUP_RETRY_MAX_SECONDS", "5")), initial)
    base = min(ceiling, initial * (2 ** min(attempt, 6)))
    return base * random.uniform(0.85, 1.15)


def _wait_for_readiness(api_url: str, deadline: float) -> bool:
    """Wait for the local API to finish its post-login startup sequence."""
    ready_url = f"{api_url.rstrip('/')}/api/v1/health/ready"
    attempt = 0
    last_notice = 0.0
    last_detail = "API socket is not accepting connections"

    while True:
        now = time.monotonic()
        if now >= deadline:
            print(f"aria: timed out waiting for readiness ({last_detail})", file=sys.stderr)
            return False
        try:
            with urllib.request.urlopen(ready_url, timeout=5) as response:
                state = json.load(response)
            if state.get("ready"):
                return True
            phase = state.get("phase", "starting")
            blocked_on = state.get("blocked_on")
            last_detail = f"{phase}: {blocked_on}" if blocked_on else phase
        except urllib.error.HTTPError as exc:
            if exc.code == 404:
                # Rolling-upgrade compatibility with an API predating /ready.
                return True
            if exc.code not in RETRYABLE_HTTP_CODES:
                print(f"aria: readiness check failed ({exc.code})", file=sys.stderr)
                return False
            try:
                state = json.loads(exc.read().decode(errors="replace"))
                phase = state.get("phase") or state.get("detail") or f"HTTP {exc.code}"
                blocked_on = state.get("blocked_on")
                last_detail = f"{phase}: {blocked_on}" if blocked_on else str(phase)
            except (ValueError, AttributeError):
                last_detail = f"HTTP {exc.code}"
        except (OSError, ValueError) as exc:
            last_detail = str(exc)

        now = time.monotonic()
        if now - last_notice >= 10 or attempt == 0:
            remaining = max(0, round(deadline - now))
            print(f"aria: waiting for ARIA ({last_detail}; up to {remaining}s)", file=sys.stderr)
            last_notice = now
        delay = min(_retry_delay(attempt), max(0, deadline - time.monotonic()))
        time.sleep(delay)
        attempt += 1


def _register_shell(request: urllib.request.Request, deadline: float) -> tuple[bool, dict]:
    """POST a deterministic shell request, retrying only startup failures."""
    attempt = 0
    while True:
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                return True, json.load(response)
        except urllib.error.HTTPError as exc:
            if exc.code == 409:
                return True, {}
            if exc.code not in RETRYABLE_HTTP_CODES:
                detail = exc.read().decode(errors="replace")[:300]
                print(f"aria: shell registration failed ({exc.code}): {detail}", file=sys.stderr)
                return False, {}
        except (OSError, ValueError) as exc:
            if time.monotonic() >= deadline:
                print(f"aria: shell registration failed: {exc}", file=sys.stderr)
                return False, {}

        if time.monotonic() >= deadline:
            print("aria: timed out registering shell after ARIA became ready", file=sys.stderr)
            return False, {}
        time.sleep(min(_retry_delay(attempt), max(0, deadline - time.monotonic())))
        attempt += 1


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in {"claude", "codex", "pi"}:
        print("usage: aria-local-shell claude|codex|pi [args...]", file=sys.stderr)
        return 2

    tool, args = sys.argv[1], sys.argv[2:]
    workdir = os.getcwd()
    base = re.sub(r"[^a-z0-9]+", "-", Path(workdir).name.lower()).strip("-") or "home"
    path_id = hashlib.sha256(workdir.encode()).hexdigest()[:6]
    request_name = f"{tool}-{base[:38]}-{path_id}"
    # POST /shells applies its prefix idempotently. Keep the fallback target in
    # sync with that rule because a repeat launch returns 409 (and therefore no
    # response body from which to read the canonical name). This matters most
    # for Claude: request_name already starts with "claude-", while Codex and
    # Pi need the prefix added.
    full_name = _canonical_shell_name(request_name)

    launcher = Path.home() / ".local" / "bin" / f"aria-{tool}-launch"
    if not launcher.is_file():
        print(f"aria: missing launch shim: {launcher}", file=sys.stderr)
        return 1

    api_key = _load_key()
    if not api_key:
        print("aria: no ARIA_API_KEY in ~/.config/aria/env", file=sys.stderr)
        return 1

    body = json.dumps(
        {
            "name": request_name,
            "workdir": workdir,
            "launch_claude": False,
            "launch_command": shlex.join([str(launcher), *args]),
            "cols": 200,
            "rows": 50,
        }
    ).encode()
    api_url = os.environ.get("ARIA_API_URL", DEFAULT_API_URL).rstrip("/")
    request = urllib.request.Request(
        f"{api_url}/api/v1/shells",
        data=body,
        method="POST",
        headers={"Content-Type": "application/json", "X-API-Key": api_key},
    )
    wait_seconds = max(float(os.environ.get("ARIA_STARTUP_WAIT_SECONDS", "300")), 0.0)
    deadline = time.monotonic() + wait_seconds
    try:
        if not _wait_for_readiness(api_url, deadline):
            return 1
        registered, shell = _register_shell(request, deadline)
    except KeyboardInterrupt:
        print("\naria: cancelled while waiting for startup", file=sys.stderr)
        return 130
    if not registered:
        return 1
    full_name = shell.get("name", full_name)

    _configure_tmux_session(full_name)
    action = "switch-client" if os.environ.get("TMUX") else "attach-session"
    return subprocess.call(["tmux", action, "-t", f"={full_name}"])


if __name__ == "__main__":
    raise SystemExit(main())
