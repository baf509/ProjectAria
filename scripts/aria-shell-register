#!/usr/bin/env python3
"""
aria-shell-register — invoked by tmux hooks to (un)register watched shells.

Usage:
    aria-shell-register <session_name> <session_path> [pane_id]
    aria-shell-register --closed <session_name>
    aria-shell-register --ensure-capture <session_name> <session_path> [pane_id]

Reads MONGODB_URI/MONGODB_DATABASE from env (falls back to ARIA defaults).
Also manages a pidfile in /tmp/aria-shell-capture-<name>.pid so that
--ensure-capture is idempotent across tmux server restarts.

This runs from a tmux hook on every session-created/client-attached, so it
MUST fail quietly: tmux renders a non-zero exit (or any stderr) from
`run-shell` as a client message that intercepts keystrokes until dismissed.
Everything therefore exits 0 and reports problems to LOGFILE instead — a
9-hour Mongo outage showed up to the user only as an undismissable
"...returned 1" popup in every watched shell.
"""
from __future__ import annotations

import os
import sys
import socket
import subprocess
import traceback
from datetime import datetime, timezone

from pymongo import MongoClient


PIDFILE_TEMPLATE = "/tmp/aria-shell-capture-{name}.pid"
CAPTURE_SHIM = os.environ.get("ARIA_SHELL_CAPTURE_BIN", "/home/ben/.local/bin/aria-shell-capture")
LOGFILE = os.environ.get("ARIA_SHELL_REGISTER_LOG", "/tmp/aria-shell-register.log")
# Short, because a tmux hook waits on this. The default 30s makes every
# attach hang for half a minute while Mongo is down.
SERVER_SELECTION_TIMEOUT_MS = int(os.environ.get("ARIA_MONGO_TIMEOUT_MS", "3000"))


def _log(message: str) -> None:
    """Best-effort append to LOGFILE. Never raises, never writes to stderr."""
    try:
        with open(LOGFILE, "a") as fp:
            fp.write(f"{_utcnow().isoformat()} {message}\n")
    except OSError:
        pass


def _db():
    uri = os.environ.get("MONGODB_URI", "mongodb://localhost:27017/?directConnection=true&replicaSet=rs0")
    dbname = os.environ.get("MONGODB_DATABASE", "aria")
    return MongoClient(uri, serverSelectionTimeoutMS=SERVER_SELECTION_TIMEOUT_MS)[dbname]


def _utcnow():
    return datetime.now(timezone.utc)


def register(name: str, project_dir: str, pane_id: str = "") -> None:
    db = _db()
    now = _utcnow()
    prefix = os.environ.get("SHELLS_TMUX_SESSION_PREFIX", "claude-")
    short = name[len(prefix):] if name.startswith(prefix) else name
    db.shells.update_one(
        {"name": name},
        {
            "$setOnInsert": {
                "name": name,
                "short_name": short,
                "project_dir": project_dir,
                "host": socket.gethostname(),
                "created_at": now,
                "line_count": 0,
                "tags": [],
            },
            "$set": {
                "status": "active",
                "last_activity_at": now,
                **({"metadata.pane_id": pane_id} if pane_id else {}),
            },
        },
        upsert=True,
    )


def mark_closed(name: str) -> None:
    db = _db()
    db.shells.update_one(
        {"name": name},
        {"$set": {"status": "stopped", "last_activity_at": _utcnow()}},
    )
    # Kill capture process if running
    pidfile = PIDFILE_TEMPLATE.format(name=name)
    try:
        with open(pidfile) as fp:
            pid = int(fp.read().strip())
        os.kill(pid, 15)
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass
    try:
        os.unlink(pidfile)
    except FileNotFoundError:
        pass


def _capture_alive(name: str) -> bool:
    pidfile = PIDFILE_TEMPLATE.format(name=name)
    try:
        with open(pidfile) as fp:
            pid = int(fp.read().strip())
    except (FileNotFoundError, ValueError):
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def ensure_capture(name: str, project_dir: str, pane_id: str = "") -> None:
    register(name, project_dir, pane_id)
    if _capture_alive(name):
        return
    # Spawn pipe-pane via tmux. The capture shim inherits env from the tmux
    # server process, so MONGODB_URI must be in the server env (or in a sourced
    # shell file read by the shim).
    # capture_output keeps tmux's own stderr (e.g. "can't find pane") out of
    # the run-shell output, which would otherwise surface as a client popup.
    proc = subprocess.run(
        ["tmux", "pipe-pane", "-o", "-t", name, f"{CAPTURE_SHIM} {name}"],
        check=False,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        _log(f"pipe-pane {name} failed rc={proc.returncode}: {proc.stderr.strip()}")


def main(argv: list[str]) -> None:
    """Dispatch. Never raises and never returns non-zero — see module docstring."""
    if not argv:
        _log("called with no arguments")
        return
    if argv[0] == "--closed":
        if len(argv) < 2 or not argv[1]:
            _log("--closed: missing session name")
            return
        mark_closed(argv[1])
        return
    if argv[0] == "--ensure-capture":
        # tmux hooks can fire with empty #{session_name} in transient states;
        # bail rather than run `tmux pipe-pane -t ""` which spams the client
        # with "command pipe-pane: -t expects an argument" forever.
        if len(argv) < 3 or not argv[1]:
            _log(f"--ensure-capture: incomplete args {argv[1:]!r}")
            return
        ensure_capture(argv[1], argv[2], argv[3] if len(argv) > 3 else "")
        return
    # Default: register
    if len(argv) < 2 or not argv[0]:
        _log(f"register: incomplete args {argv!r}")
        return
    register(argv[0], argv[1], argv[2] if len(argv) > 2 else "")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception:
        # Mongo down, tmux gone, bad env — all of it is logged, none of it is
        # allowed to reach the tmux client as a popup.
        _log(f"argv={sys.argv[1:]!r}\n{traceback.format_exc().rstrip()}")
    sys.exit(0)
