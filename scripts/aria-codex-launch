#!/usr/bin/env bash
# ARIA - resume-aware Codex launch for watched shells
#
# Codex counterpart to aria-claude-launch: the launch command the `codex()`
# desk wrapper passes to POST /api/v1/shells as `launch_command`. Tries to
# resume the most recent Codex session for this directory (`codex resume
# --last` is cwd-filtered by default) so a respawned shell (reboot, crash,
# killed tmux server) doesn't silently drop you into an empty conversation.
#
# Codex replays the entire prior rollout when it resumes, so a very large
# session used to keep every new shell in that directory slow for minutes.
# Auto-resume is disabled by default because even a moderate rollout is visibly
# replayed through tmux and its capture pipeline. Set
# ARIA_CODEX_RESUME_MAX_BYTES to a positive byte limit to opt in; candidates
# above that limit still start fresh. `codex resume` remains available on
# demand.
#
# Unlike Claude Code, Codex gives no cheap way to ask "is there history for
# this cwd?" (session cwd lives inside ~/.codex/sessions rollout files), so
# the size guard reads only the first line of each rollout. A failed resume
# (nothing to resume, corrupt rollout) always falls back to a fresh session
# instead of leaving a dead pane behind — same fallback pattern
# aria-claude-launch uses for a corrupt history.
set -uo pipefail

# tmux updates a new session from the creating client's environment. ARIA's
# launchd service and SSH clients can therefore replace tmux's otherwise-good
# global PATH with a system-only PATH. Keep the launch shim self-contained so
# the standalone Codex binary is available regardless of who created it.
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

# Termius does not advertise synchronized-output support, so full-screen frame
# updates are visibly painted line by line. Keep ARIA's Codex TUI inline,
# disable its decorative animations, and bound resize reflow. Codex otherwise
# clears terminal scrollback and replays up to 1,000 rendered rows whenever a
# mobile viewport changes size. The smaller replay remains configurable for a
# client that can paint synchronized frames efficiently.
RESIZE_REFLOW_MAX_ROWS="${ARIA_CODEX_RESIZE_REFLOW_MAX_ROWS:-250}"
case "$RESIZE_REFLOW_MAX_ROWS" in
    ''|*[!0-9]*) RESIZE_REFLOW_MAX_ROWS=250 ;;
esac
TUI_ARGS=(
    --no-alt-screen
    -c tui.animations=false
    -c "tui.terminal_resize_reflow_max_rows=$RESIZE_REFLOW_MAX_ROWS"
)

# Detached sessions cannot answer approval prompts. Keep them autonomous but
# fail closed outside the workspace by default. An explicit caller request for
# Codex's bypass mode takes precedence; combining it with either option below
# is rejected by the Codex argument parser and previously killed the new tmux
# session before aria-local-shell could attach to it.
CODEX_ARGS=(--sandbox workspace-write --ask-for-approval never)
BYPASS_DEFAULTS=0
for arg in "$@"; do
    case "$arg" in
        --yolo|--dangerously-bypass-approvals-and-sandbox)
            BYPASS_DEFAULTS=1
            break
            ;;
    esac
done

# Newest rollout for this cwd, by bytes. Reads one line per rollout file, so
# the guard stays cheap even with years of session history. Prints 0 when
# python3 or the session store is unavailable — auto-resume then proceeds
# exactly as before this guard existed.
_resume_candidate_bytes() {
    python3 - "$PWD" <<'PY'
import json, os, pathlib, sys

cwd = sys.argv[1]
home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
root = pathlib.Path(home) / "sessions"
best_key = None
best_size = 0
if root.is_dir():
    for path in root.rglob("*.jsonl"):
        try:
            with path.open("rb") as fh:
                meta = json.loads(fh.readline())
            if (meta.get("payload") or meta).get("cwd") != cwd:
                continue
            stat = path.stat()
        except (OSError, ValueError):
            continue
        key = (stat.st_mtime, stat.st_size, path.name)
        if best_key is None or key > best_key:
            best_key, best_size = key, stat.st_size
print(best_size)
PY
}

RESUME_MAX_BYTES="${ARIA_CODEX_RESUME_MAX_BYTES:-0}"
case "$RESUME_MAX_BYTES" in
    ''|*[!0-9]*) RESUME_MAX_BYTES=0 ;;
esac

attempt_resume=1
if (( RESUME_MAX_BYTES == 0 )); then
    attempt_resume=0
else
    candidate_bytes=$(_resume_candidate_bytes 2>/dev/null || printf '0')
    if (( candidate_bytes > RESUME_MAX_BYTES )); then
        attempt_resume=0
        printf 'aria: newest codex session here is %d MB; skipping auto-resume (ARIA_CODEX_RESUME_MAX_BYTES=%d)\n' \
            "$((candidate_bytes / 1048576))" "$RESUME_MAX_BYTES" >&2
        printf 'aria: starting fresh — run `codex resume` to open the old session anyway\n' >&2
    fi
fi

# Name the tmux window after the tool (`0:codex`, not `0:bash`); see
# aria-claude-launch for why automatic-rename shows the wrong thing.
if [ -n "${TMUX:-}" ]; then
    tmux rename-window -t "${TMUX_PANE:-}" codex 2>/dev/null || true
fi

if (( attempt_resume )); then
    if (( BYPASS_DEFAULTS )); then
        codex resume --last "${TUI_ARGS[@]}" "$@"
    else
        codex resume --last "${TUI_ARGS[@]}" "${CODEX_ARGS[@]}" "$@"
    fi
    rc=$?
    # A non-zero exit means resume could not start (no session for this cwd,
    # corrupt rollout) rather than a session you used and quit — the TUI exits
    # 0 on a normal quit. Always start a fresh session instead of leaving a
    # dead pane behind, whatever the failure took.
    if (( rc == 0 )); then
        exit 0
    fi
    echo "aria: codex resume --last failed (exit $rc) — starting a fresh session" >&2
fi
if (( BYPASS_DEFAULTS )); then
    exec codex "${TUI_ARGS[@]}" "$@"
fi
exec codex "${TUI_ARGS[@]}" "${CODEX_ARGS[@]}" "$@"
