#!/usr/bin/env python3
"""Migrate live Ralph-named state to the Loop naming. Dry run unless --apply.

The source rename is a code change; this is the matching data change. Run it
once, with the API stopped, between deploying the renamed release and starting
it. Order matters: renamed code reads `loop_*` collections and `~/.aria/loop`,
so a started service on unmigrated state sees an empty controller.

Not covered, deliberately: the two target repositories still carry "ralph" in
their own directory names (AgentWorkspaces/ralph-example and
flashnext-ralph-20260906). They live outside this project, and renaming them
changes each run's target identity and the policy digest. Rename them
separately if you want them gone, and re-approve affected runs.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

from pymongo import MongoClient

ARIA = Path.home() / ".aria"
ACTIVE = {"running", "verifying", "final_verifying", "approved", "paused", "draft"}
COLLECTIONS = [("ralph_runs", "loop_runs"), ("ralph_logs", "loop_logs"), ("ralph_targets", "loop_targets")]
PATHS = [(ARIA / "ralph", ARIA / "loop"),
         (ARIA / "ralph-policy.json", ARIA / "loop-policy.json"),
         (ARIA / "ralph-checks", ARIA / "loop-checks")]
ENV_FILE = Path.home() / "Services/apps/ProjectAria/.env"


def rewrite(value):
    """Rewrite controller-owned strings only; never a target repository path."""
    return (value.replace("/.aria/ralph-checks", "/.aria/loop-checks")
                 .replace("/.aria/ralph-policy.json", "/.aria/loop-policy.json")
                 .replace("/.aria/ralph/", "/.aria/loop/")
                 .replace("/.aria/ralph", "/.aria/loop")
                 .replace("aria-ralph-", "aria-loop-")
                 .replace("refs/heads/ralph/", "refs/heads/loop/"))


def walk(value):
    if isinstance(value, str):
        return rewrite(value)
    if isinstance(value, list):
        return [walk(v) for v in value]
    if isinstance(value, dict):
        return {k: walk(v) for k, v in value.items()}
    return value


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true", help="perform the migration (default: dry run)")
    parser.add_argument("--mongo", default=os.environ.get(
        "MONGODB_URI", "mongodb://127.0.0.1:27018/?directConnection=true&replicaSet=rs0"))
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "aria"))
    args = parser.parse_args()
    act = args.apply
    say = (lambda m: print("  " + m)) if act else (lambda m: print("  [dry run] " + m))

    db = MongoClient(args.mongo).get_database(args.database)
    names = db.list_collection_names()

    print("Preconditions")
    if "loop_runs" in names:
        sys.exit("  loop_runs already exists; migration appears to have run already")
    blocking = list(db.ralph_runs.find({"state": {"$in": list(ACTIVE)}}, {"state": 1}))
    if blocking:
        sys.exit(f"  refusing: {len(blocking)} run(s) not terminal: "
                 + ", ".join(f"{r['_id']}={r['state']}" for r in blocking))
    print(f"  {db.ralph_runs.count_documents({})} runs, all terminal")

    print("Mongo collections")
    for old, new in COLLECTIONS:
        if old not in names:
            say(f"{old} absent, skipping")
            continue
        say(f"{old} -> {new} ({db[old].count_documents({})} docs)")
        if act:
            db[old].rename(new)

    print("Mongo controller-owned strings")
    runs = db.loop_runs if act else db.ralph_runs
    targets = db.loop_targets if act else db.ralph_targets
    for collection in (runs, targets):
        for doc in list(collection.find()):
            updated = walk({k: v for k, v in doc.items() if k != "_id"})
            if updated != {k: v for k, v in doc.items() if k != "_id"}:
                say(f"{collection.name}/{doc['_id']}: rewrote controller paths and container names")
                if act:
                    collection.replace_one({"_id": doc["_id"]}, {"_id": doc["_id"], **updated})

    count = db.guard_events.count_documents({"kind": {"$regex": "^ralph\\."}})
    say(f"guard_events: re-prefix {count} 'ralph.*' -> 'loop.*'")
    if act:
        for event in list(db.guard_events.find({"kind": {"$regex": "^ralph\\."}}, {"kind": 1})):
            db.guard_events.update_one({"_id": event["_id"]},
                                       {"$set": {"kind": "loop." + event["kind"].split(".", 1)[1]}})

    print("Filesystem")
    for old, new in PATHS:
        if not old.exists():
            say(f"{old} absent, skipping")
            continue
        if new.exists():
            sys.exit(f"  refusing: {new} already exists")
        say(f"{old} -> {new}")
        if act:
            shutil.move(str(old), str(new))

    policy = ARIA / ("loop-policy.json" if act else "ralph-policy.json")
    if policy.exists():
        data = json.loads(policy.read_text())
        for slug, project in data.get("projects", {}).items():
            if "ralph-checks" in project.get("assets", ""):
                say(f"policy {slug}: assets -> {rewrite(project['assets'])}")
                project["assets"] = rewrite(project["assets"])
        if act:
            policy.write_text(json.dumps(data, indent=2) + "\n")

    print("Git checkpoint refs")
    root = ARIA / ("loop" if act else "ralph")
    for git_dir in sorted(root.glob("*/checkpoints.git")) if root.exists() else []:
        listed = subprocess.run(["git", "--git-dir", str(git_dir), "for-each-ref",
                                 "refs/heads/ralph", "--format=%(refname)"],
                                capture_output=True, text=True).stdout.split()
        for ref in listed:
            new_ref = rewrite(ref)
            say(f"{git_dir.parent.name}: {ref} -> {new_ref}")
            if act:
                subprocess.run(["git", "--git-dir", str(git_dir), "update-ref", new_ref,
                                subprocess.run(["git", "--git-dir", str(git_dir), "rev-parse", ref],
                                               capture_output=True, text=True).stdout.strip()], check=True)
                subprocess.run(["git", "--git-dir", str(git_dir), "update-ref", "-d", ref], check=True)

    print("Service environment")
    if ENV_FILE.exists():
        text = ENV_FILE.read_text()
        updated = rewrite(text.replace("RALPH_", "LOOP_"))
        if updated != text:
            say(f"{ENV_FILE}: RALPH_* -> LOOP_* (backup alongside as .env.pre-loop-rename)")
            if act:
                (ENV_FILE.parent / ".env.pre-loop-rename").write_text(text)
                ENV_FILE.write_text(updated)

    print("\nDone." if act else "\nDry run only. Re-run with --apply to perform it.")
    print("Renaming the checks directory changes each project's policy digest, so any\n"
          "run approved under the old digest must be re-approved before it can resume.")


if __name__ == "__main__":
    main()
